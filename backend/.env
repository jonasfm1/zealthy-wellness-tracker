# backend/.env

# The secret key for encoding/decoding JWTs. Make this a long, random string in production.
JWT_SECRET_KEY=super_secret_jwt_key_for_production_12345

# Database connection string (You will replace this with the Aiven URL later)
DATABASE_URL=mysql+pymysql://root:54802836@localhost:3306/zealthy_db

# The exact URL of your frontend to restrict CORS access
FRONTEND_URL=http://localhost:3000

# Flask environment configuration
FLASK_ENV=production
FLASK_DEBUG=0